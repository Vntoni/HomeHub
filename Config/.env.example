# Skopiuj ten plik jako Config/.env i uzupełnij swoje dane
# cp Config/.env.example Config/.env

# --- Airstage (AC) ---
AIRSTAGE_USER="twoj@email.com"
AIRSTAGE_PWD="twoje_haslo"
AIRSTAGE_COUNTRY="PL"
AC_SALON_ID="XXXXXXXXXXXX"
AC_JADALNIA_ID="XXXXXXXXXXXX"

# --- Ariston (boiler) ---
ARISTON_DEVICE_ID="XXXXXXXXXXXX"
ARISTON_PWD="twoje_haslo"

# --- Washer (BLE) ---
WASHER_POLL_SECONDS=10

# --- PostgreSQL, pogoda i sensory Zigbee ---
# Przykładowe wartości; uzupełnij lokalnie. Interwał pogody jest w sekundach.
DB_DSN="postgresql://USER:PASSWORD@localhost/DATABASE"
WEATHER_LATITUDE=0.0
WEATHER_LONGITUDE=0.0
WEATHER_POLL_INTERVAL=3600
SENSOR_ROOMS="salon,jadalnia"

# --- Atlantic Cozy Touch (grzejniki) ---
COZYTOUCH_USER="GA-PRIVATEPERSON/twoj@email.com"
COZYTOUCH_PWD="twoje_haslo"
COZYTOUCH_SCOPE="openid device_XXXXXXXXXXXXXXXXX"
